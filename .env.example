APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
ALLOWED_ORIGINS=https://11112026.netlify.app

# OpenAI 비밀키는 실제 .env 또는 Google Cloud Secret Manager에서 주입합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_SKILL_ID=skill_6af440f78bb08191bcd8bc8691b228bb05903870db4bc490
OPENAI_SKILL_VERSION=latest
OPENAI_REQUEST_TIMEOUT_SECONDS=120

# production에서는 firestore를 사용합니다. 테스트는 memory를 사용합니다.
STORAGE_BACKEND=firestore
FIRESTORE_PROJECT_ID=your-firebase-project-id
FIRESTORE_COLLECTION=work_sessions

# 로컬 서비스 계정 사용 시에만 설정합니다. 파일은 저장소에 커밋하지 않습니다.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
